{
    "name":"DHARANI Data Tutorial DevContainer",
    "image":"mcr.microsoft.com/devcontainers/python:3.10",
    "features":{},
    "postCreateCommand": "pip install -r requirements_3.10.txt",
    "customizations":{
        "vscode":{
            "settings":{},
            "extensions":[
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "mounts":[
        "source=${localWorkspaceFolder}/data,target=/workspace/data,type=bind,consistency=cached"
    ]
}
